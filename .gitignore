# =========================================================
# 🔒 SECRETS & ENV FILES (NEVER COMMIT)
# =========================================================
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local

# CRITICAL: Allow the example file so devs know required variables
!.env.example

# Certificates & Keys
*.pem
*.key
*.crt

# =========================================================
# 🌐 NODE.JS / FRONTEND (Vite & React)
# =========================================================
node_modules/
dist/
dist-ssr/
build/
.vite/
.eslintcache
.npm/

# =========================================================
# 🧪 TEST OUTPUT / COVERAGE (Playwright & Vitest)
# =========================================================
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.vitest/

# =========================================================
# 📜 LOG FILES
# =========================================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================================================
# 🐳 DOCKER / INFRASTRUCTURE (Local State)
# =========================================================
# Ignore local database volumes or logs if mounted from docker-compose
infra/db-data/
infra/nginx/logs/

# =========================================================
# 📦 ARCHIVES / TEMP FILES
# =========================================================
*.zip
*.tar
*.gz
*.tmp
*.bak
*.swp
*~

# =========================================================
# 💻 IDE / EDITOR FILES
# =========================================================
.vscode/*
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Allow VS Code recommendations and specific project settings
!.vscode/extensions.json
!.vscode/settings.json

# =========================================================
# 🖥 OS FILES
# =========================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db