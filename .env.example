# -----------------------------------------------------------------------------
# A2Z Utility Hub Environment Variables
#
# This file serves as a template for the required environment variables.
# For local development, you can copy this file to .env and fill in the values.
# For production, these variables should be set in your hosting environment.
# -----------------------------------------------------------------------------

# --- Supabase (Required) ---
# These are used by the Vite build process and the client-side Supabase SDK.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-public-anon-key"

# --- Supabase Service Role (For server-side operations like in Edge Functions) ---
# This key has full access to your database and should be kept secret.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# --- Node.js Server (For Production) ---
# The port the Node.js app should listen on. Managed by Passenger on Hostinger.
PORT=3000
# Set to 'production' on the server.
NODE_ENV="development"

# --- Database (For direct connections, e.g., from a backend service) ---
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-DB-HOST]:5432/postgres"

# --- Authentication & Security ---
# A random string used for signing tokens, etc.
# You can generate one with `openssl rand -base64 32`
APP_SECRET="a-very-secret-string-for-your-app"
APP_URL="http://localhost:5173" # Change to your production URL

# --- OAuth Providers (Optional) ---
# Fill these in if you want to enable social logins.
# Get them from the respective developer consoles.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Email Service (Optional, for sending emails) ---
# Example for SMTP. Could be SendGrid, Postmark, etc.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@a2zutilityhub.com"

# --- AI / LLM Provider (Optional, for Chatbot) ---
# Currently configured for OpenRouter, but can be adapted.
OPENROUTER_API_KEY=""

# --- Analytics (Optional) ---
GA_ID="" # Google Analytics ID (e.g., G-XXXXXXXXXX)
PLAUSIBLE_DOMAIN="" # Your domain for Plausible Analytics

# --- Storage Provider (Required) ---
# Choose one: "supabase", "cloudflare_r2", "backblaze_b2", "wasabi", "s3", "cloudinary", "minio"
STORAGE_PROVIDER="supabase"
# Credentials for the chosen provider (if not Supabase)
# Example for S3-compatible services (R2, B2, Wasabi, DO, MinIO)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION=""
# Example for Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Payment Gateways (Optional) ---
# Set the active provider and fill in keys for all you want to support.
PAYMENT_ACTIVE_PROVIDER="stripe" # e.g., "stripe", "razorpay", "paypal"
# Stripe
STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Razorpay
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
# Others...
PAYTM_MERCHANT_ID=""
PAYTM_MERCHANT_KEY=""
INSTAMOJO_API_KEY=""
INSTAMOJO_AUTH_TOKEN=""
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CCAVENUE_MERCHANT_ID=""
CCAVENUE_ACCESS_CODE=""
CCAVENUE_WORKING_KEY=""
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""

# --- Messaging & Chat (Optional) ---
# WhatsApp Provider
WHATSAPP_PROVIDER="twilio" # e.g., "twilio", "vonage"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
VONAGE_API_KEY=""
VONAGE_API_SECRET=""

# Self-hosted Chat/Notification Services
POSTAL_URL=""
CHATWOOT_URL=""
ROCKET_CHAT_URL=""